{
  "name": "tangent-prime-worker-cli",
  "version": "0.0.1",
  "description": "Run a Tangent session's Prime as a worker pane for a local orchestrator such as herdr.",
  "private": true,
  "type": "module",
  "prettier": "@tangent/build/prettier",
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "node esbuild.mjs && node ../acp-attach-cli/package.mjs tangent-prime-worker tangent-prime-worker.mjs dist/skill",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tangent/local-agent-host": "workspace:*",
    "@tangent/shared": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tangent/build": "workspace:*",
    "@types/node": "^25.9.1",
    "esbuild": "0.28.0",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
