{
  "name": "tangent-instance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "prettier": "@tangent/build/prettier",
  "scripts": {
    "dev": "SESSIONS_ROOT=\"$PWD/.sessions\" SESSIONS_DB=\"$PWD/.sessions/tangent.db\" AGENT_BUNDLES_ROOT=\"$PWD/.agent-bundles\" GLOBAL_MEMORY_DIR=\"$PWD/.memory\" turbo run dev",
    "seed": "AGENT_BUNDLES_ROOT=\"$PWD/.agent-bundles\" SEED_BUNDLES_DIR=\"$PWD/examples/configs\" pnpm --filter @tangent/server seed",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "validate": "turbo run typecheck lint build",
    "analyze:server": "fta apps/server/src",
    "analyze:web": "fta apps/web/src",
    "pack:bundle": "node scripts/pack-bundle.mjs"
  },
  "devDependencies": {
    "@tangent/build": "workspace:*",
    "fflate": "^0.8.3",
    "fta-cli": "^3.0.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
